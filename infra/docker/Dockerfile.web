# Build stage — produce the static export (WEB-0005)
FROM node:24-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@12.5.1 --activate

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/world/package.json ./packages/world/

# Install dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source code
COPY apps/web ./apps/web
COPY packages ./packages

# NEXT_PUBLIC_* is inlined into the bundle here — there is no server to read
# it later, so the compose file passes the browser-visible API origin.
ARG NEXT_PUBLIC_JEVE_API=http://127.0.0.1:8000
ENV NEXT_PUBLIC_JEVE_API=$NEXT_PUBLIC_JEVE_API

# `output: "export"` makes this emit plain files to apps/web/out
RUN pnpm --filter @jeve/web build

# Runtime stage — a static file server, not a Next server
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY --from=builder /app/apps/web/out /usr/share/nginx/html
COPY infra/docker/nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1
