{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"plugins": [
		{
			"plugin": "@nxlv/python",
			"options": {
				"packageManager": "uv",
				"workspaceRoot": "py"
			}
		}
	],
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"sharedGlobals": [
			"{workspaceRoot}/mise.toml",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/py/uv.lock"
		],
		"production": [
			"default",
			"!{projectRoot}/**/*.spec.ts",
			"!{projectRoot}/e2e/**/*",
			"!{projectRoot}/**/*.test.ts",
			"!{projectRoot}/tests/**/*"
		],
		"python": [
			"{projectRoot}/**/*.py",
			"{projectRoot}/pyproject.toml",
			"{projectRoot}/uv.lock",
			"{workspaceRoot}/py/src/**/*.py"
		],
		"typescript": [
			"{projectRoot}/**/*.ts",
			"{projectRoot}/**/*.tsx",
			"{projectRoot}/package.json",
			"{workspaceRoot}/packages/contracts/src/**/*.ts"
		],
		"contracts": [
			"{workspaceRoot}/tools/contract-gen/**/*.py",
			"{workspaceRoot}/py/src/jeve/**/*.py"
		]
	},
	"targetDefaults": {
		"build": {
			"cache": true,
			"dependsOn": ["^build", "contracts:generate"],
			"inputs": ["production", "^production"]
		},
		"typecheck": {
			"cache": true,
			"dependsOn": ["^build", "contracts:generate"],
			"inputs": ["default", "^production"]
		},
		"lint": {
			"cache": true,
			"inputs": [
				"default",
				"{workspaceRoot}/.eslintrc.json",
				"{workspaceRoot}/py/ruff.toml"
			]
		},
		"e2e": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"test": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": ["default", "{workspaceRoot}/py/tests/**/*.py"]
		},
		"sync": {
			"cache": false,
			"inputs": [
				"{workspaceRoot}/py/pyproject.toml",
				"{workspaceRoot}/py/uv.lock"
			]
		},
		"generate": {
			"cache": false,
			"inputs": ["contracts"]
		},
		"check-drift": {
			"cache": false,
			"dependsOn": ["generate"],
			"inputs": ["contracts"]
		},
		"docker-build": {
			"cache": true,
			"dependsOn": ["build"],
			"inputs": [
				"production",
				"{workspaceRoot}/infra/docker/*",
				"{workspaceRoot}/.dockerignore"
			]
		},
		"dev": {
			"cache": false,
			"continuous": true
		},
		"start": {
			"cache": false,
			"dependsOn": ["build"]
		},
		"run": {
			"cache": false,
			"dependsOn": ["sync"]
		}
	}
}
