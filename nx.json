{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/e2e/**/*"
    ]
  },
  "targetDefaults": {
    "build": { "cache": true, "dependsOn": ["^build"] },
    "typecheck": { "cache": true, "dependsOn": ["^build"] },
    "lint": { "cache": true },
    "e2e": { "cache": false }
  }
}
