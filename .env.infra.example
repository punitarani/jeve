# Infrastructure and CI/CD environment (GitHub Actions)
# Copy to .env for local development or set in GitHub Secrets

# Database for CI/CD
JEVE_DATABASE_URL=postgresql://jeve:jeve@localhost:5432/jeve

# Deployment targets
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# FLY_API_TOKEN=your-fly-api-token
# FLY_APP_NAME=jeve-backend

# Docker registry (if using)
# DOCKER_REGISTRY=your-registry
# DOCKER_USERNAME=your-username
# DOCKER_PASSWORD=your-password

# Monitoring and alerting
# SENTRY_DSN=your-sentry-dsn
# DATADOG_API_KEY=your-datadog-key