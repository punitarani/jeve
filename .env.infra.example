# CI/CD credentials — GitHub Actions secrets / the Doppler `infra` project.
# Nothing here is read by the code; these authenticate the deploy.

# Cloudflare (deploy-web): Workers static assets upload.
# CLOUDFLARE_API_TOKEN=cfut_...
# CLOUDFLARE_ACCOUNT_ID=64485cb6...

# Fly.io (deploy-backend): image build + machine update + release migration.
# FLY_API_TOKEN=FlyV1 ...

# Doppler (deploy-backend): a read-only service token for worker/prd, which
# CI's own DOPPLER_TOKEN cannot read. Used to stage BRAINTRUST_* on Fly
# (OPS-0004).
# DOPPLER_WORKER_TOKEN=dp.st.prd...

# The CI job that needs a database (python) runs a Postgres service
# container and sets JEVE_DATABASE_URL itself — no secret needed.
