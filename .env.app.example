# Web app (apps/web) — Cloudflare Workers static assets (WEB-0005).
# Copy to apps/web/.env.local for local development.
#
# NEXT_PUBLIC_* is inlined into the bundle at BUILD time — there is no
# server to read it later, so changing it means rebuilding and redeploying.

# The API origin as the browser sees it.
NEXT_PUBLIC_JEVE_API=http://127.0.0.1:8000
# Production build uses: NEXT_PUBLIC_JEVE_API=https://jeve-api.punitarani.com

# Cloudflare deploy credentials live in GitHub Actions secrets / Doppler
# (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID) — never in this file.
