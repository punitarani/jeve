# Secrets. Never relax this.
.env
.env.*
!.env.example
!.env.*.example

# Operational state written at runtime (spend ledger, night/gate state).
# The repo-root ops/ is tracked so the directory exists on a clean clone; its
# contents are not. A nested ops/ is a bug (something resolved it against the
# wrong cwd) — ignore it so it can never be committed.
/ops/*
!/ops/.gitkeep
!/ops/README.md
# Measurements are evidence, not state: written only by a LIVE run, and tracked
# so a morning reader sees exactly what was measured, against which commit.
!/ops/economics.md
!/ops/providers.md
!/ops/persona-probe.md
!/ops/soak.md
!/ops/soak.live.md
!/ops/episodes.md
!/ops/field-report-v2.md
!/ops/escalation.md
!/ops/judge-panel.md
!/ops/ontology-gaps.md
!/ops/situation-probe.md
# EVAL-0001: the eval report and the small per-world JSON it is rendered from.
# The eval cassettes are tens of megabytes a sweep and stay local.
!/ops/evals.md
!/ops/evals/
/ops/evals/cassettes/
# A nested ops/ means something resolved it against the wrong cwd. Ignored so
# it can never be committed; `ops/` at the root is the only real one. (A bare
# `ops/` here would also re-ignore the root one — later patterns win.)
py/ops/
apps/*/ops/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
*.egg-info/

# Node
node_modules/
.next/
# JEVE_NEXT_DIST picks the export dir (e2e, visual probes); cover them all.
.next-*/
next-env.d.ts
out/
.turbo/
*.tsbuildinfo

# Nx
.nx/cache
.nx/workspace-data

# Playwright
test-results/
playwright-report/
blob-report/

# macOS
.DS_Store
node_modules/
.nx/
test-results/
playwright-report/

# Worktrees a parallel agent works in.
.claude/worktrees/
