{
  "$id": "https://github.com/punitarani/jeve/decisions/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated by scripts/gen-decisions.py from a single field spec. Do not edit; edit the spec.",
  "properties": {
    "confirmation": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "deciders": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Z][A-Z0-9]{1,7}-\\d{4}$",
      "type": "string"
    },
    "relates-to": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ],
      "type": "string"
    },
    "superseded-by": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "date",
    "deciders",
    "scope",
    "tags",
    "supersedes",
    "superseded-by",
    "relates-to",
    "confirmation"
  ],
  "title": "jeve decision record front matter",
  "type": "object"
}
