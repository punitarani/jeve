# Backend services (api + sim) — Fly.io process groups. Copy to .env for
# local runs; in production these are `fly secrets` / fly.toml [env].

# Postgres. The daemon needs the direct DSN: its writer lock is a
# session-level advisory lock, which a transaction pooler drops (OPS-0001).
# DATABASE_URL is read as a fallback (fly postgres attach writes it).
JEVE_DATABASE_URL=postgresql://jeve:jeve@127.0.0.1:55432/jeve
# JEVE_DATABASE_POOLED_URL=postgresql://jeve:jeve@host:6432/jeve   # api only
# JEVE_PG_PORT=55432           # local default when no URL is set

# OpenRouter — the only billable path, and only through jeve.llm (LLM-0001).
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Braintrust — LLM observability (LLM-0008). The key is the only switch:
# unset it and jeve.tracing never imports the SDK or opens a socket, which is
# how a clean clone and CI stay offline. Spans carry OpenRouter's real cost,
# not an estimate, so the trace and the spend ledger agree.
# BRAINTRUST_API_KEY=sk-...
# BRAINTRUST_PROJECT=jeve      # the project spans land in

# Daemon (python -m jeve.sim)
# JEVE_POLICY=jev              # rules | jev
# JEVE_CALLS=record            # record | replay — production must record
# JEVE_CASSETTE=off            # off: Postgres model_calls is the cache
# JEVE_SIM_DAY_MINUTES=24      # wall minutes per sim day
# JEVE_DAILY_BUDGET_USD=2.0    # governor: pauses the clock when spent
# JEVE_BUDGET_WAIT_S=900       # minutes-scale retry while upstream is out

# Spend ladder (LLM-0007): observability/safety — OpenRouter's cap is the
# real stop. 0 or negative disables the per-process run cap. The ladder is
# measured against lifetime ledger spend: the dev defaults below would halt
# a production daemon for good at $16, so fly.toml sets all three to $10k.
# JEVE_RUN_CAP_USD=0
# JEVE_EXPLORE_CEILING_USD=12
# JEVE_HALT_CEILING_USD=16
# JEVE_HARD_CEILING_USD=20

# API (uvicorn jeve.api.app:app)
# JEVE_CORS_ORIGINS=https://jeve.punitarani.com   # comma-separated; unset = localhost any port
# JEVE_DIALOGUE_GENERATE=off                     # off: cached prose only, no spend
# JEVE_OPS_DIR=ops                               # spend.json checkpoint etc.
