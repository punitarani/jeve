# Backend services environment (Fly.io)
# Copy to .env for local development

# Database connection (shared by API and worker)
JEVE_DATABASE_URL=postgresql://jeve:jeve@localhost:55432/jeve

# API service configuration
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=1

# Simulation worker configuration
# JEVE_SIM_POLICY=jev|rules
# JEVE_SIM_CALLS=replay|record
# JEVE_SIM_DAYS=35
# JEVE_SIM_SPEED=1.0

# Budget controls
# JEVE_BUDGET_CEILING_USD=20.0
# JEVE_BUDGET_EXPLORATION_USD=12.0

# Fly.io deployment
# FLY_API_TOKEN=your-fly-api-token
# FLY_APP_NAME=jeve-backend
# FLY_REGION=sjc