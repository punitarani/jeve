# Dependencies — `**/`: dockerignore patterns are root-relative, so a bare
# `node_modules` ignored only the root one and every nested copy still shipped
# (the build context was ~700 MB, mostly apps/web/node_modules and py/.venv).
**/node_modules
**/.venv
**/__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Build outputs
**/.next
**/.next-*
**/out
**/dist
**/build
*.tsbuildinfo

# Development
.env
.env.*
!.env.*.example
!.env.example

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
**/.nx
**/coverage
**/.nyc_output
**/.pytest_cache
**/.turbo
**/playwright-report
**/test-results

# Documentation not needed at runtime
docs/
tools/
decisions/
apps/web/e2e/
*.md
!README.md

# CI/CD
.github/

# Temporary files
tmp/
temp/
*.tmp

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Ops (runtime state)
ops/
worktrees/

# Tests and fixtures are not needed in the production image
py/tests/
py/fixtures/
py/scripts/
scripts/
